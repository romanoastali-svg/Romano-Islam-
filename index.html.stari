ps://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/096.mp3","97":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/097.mp3","98":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/098.mp3","99":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/099.mp3","100":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/100.mp3","101":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/101.mp3","102":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/102.mp3","103":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/103.mp3","104":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/104.mp3","105":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/105.mp3","106":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/106.mp3","107":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/107.mp3","108":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/108.mp3","109":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/109.mp3","110":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/110.mp3","111":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/111.mp3","112":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/112.mp3","113":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/113.mp3","114":"https://audio-cdn.tarteel.ai/quran/surah/yasserAlDosari/murattal/mp3/114.mp3"};
function source(){return surahAudio[sura.value] || ''}
function load(){
  audio.pause(); verse=1; audio.src=source(); audio.load(); refresh();
  button.textContent='▶ Šun — Slušaj';
  status.textContent='Izaberi Slušaj. Ajeti su usklađeni prema vremenskim oznakama učača Yassera Al-Dosarija.';
}
function play(){
  const promise=audio.play();
  if(promise && promise.catch) promise.catch(()=>{
    status.textContent='Snimak nije moguće pokrenuti. Provjeri internetsku vezu.';
  });
}
function updateText(){
  const marks=timingData[sura.value];
  if(!marks)return;
  const ms=audio.currentTime*1000;
  let lo=1, hi=counts[Number(sura.value)-1], next=1;
  while(lo<=hi){
    const mid=Math.floor((lo+hi)/2);
    const item=marks[String(mid)];
    if(!item){hi=mid-1;continue;}
    if(ms>=item[0]){next=mid;lo=mid+1;}
    else hi=mid-1;
  }
  if(next!==verse){verse=next;refresh();}
}
sura.addEventListener('change',load);
button.addEventListener('click',()=>{if(audio.paused)play();else audio.pause()});


audio.addEventListener('timeupdate',updateText);
audio.addEventListener('seeked',updateText);
audio.addEventListener('playing',()=>{button.textContent='Ⅱ Pauza';status.textContent='Uči Yasser Al-Dosari · cijela sura bez prekida · tekst se mijenja prema vremenskim oznakama'});
audio.addEventListener('pause',()=>{button.textContent='▶ Šun — Slušaj'});
audio.addEventListener('ended',()=>{verse=counts[Number(sura.value)-1];refresh();status.textContent='Sura je završena.';button.textContent='▶ Šun — Slušaj'});
audio.addEventListener('error',()=>{status.textContent='Snimak cijele sure nije dostupan na ovom izvoru.'});
load();
})();
</script>
<script>
(function(){
  fetch('https://api.alquran.cloud/v1/surah/2')
    .then(r=>{if(!r.ok)throw Error('offline');return r.json()})
    .then(j=>{
      if(!j.data||!j.data.ayahs)throw Error('data');
      for(let n=61;n<=286;n++){
        const e=document.getElementById('bek-ar-'+n);
        const a=j.data.ayahs[n-1];
        if(e&&a&&a.text)e.textContent=a.text;
      }
    }).catch(()=>{
      for(let n=61;n<=286;n++){
        const e=document.getElementById('bek-ar-'+n);
        if(e)e.textContent='Arapski tekst trenutno nije dostupan bez internetske veze.';
      }
    });
})();
</script>
</body></html>

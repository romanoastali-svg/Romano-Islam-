"95">95. Et-Tin</option><option value="96">96. El-Alek</option><option value="97">97. El-Kadr</option><option value="98">98. El-Bejjina</option><option value="99">99. Ez-Zilzal</option><option value="100">100. El-Adijat</option><option value="101">101. El-Karia</option><option value="102">102. Et-Tekasur</option><option value="103">103. El-Asr</option><option value="104">104. El-Humeze</option><option value="105">105. El-Fil</option><option value="106">106. Kurejš</option><option value="107">107. El-Maun</option><option value="108">108. El-Kevser</option><option value="109">109. El-Kafirun</option><option value="110">110. En-Nasr</option><option value="111">111. El-Mesed</option><option value="112">112. El-Ihlas</option><option value="113">113. El-Felek</option><option value="114">114. En-Nas</option></select>

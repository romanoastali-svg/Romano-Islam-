(function(){
const audio=document.getElementById('quranAudio'),sura=document.getElementById('audioSurah'),status=document.getElementById('audioStatus'),current=document.getElementById('currentVerse'),bos=document.getElementById('bosanskiPrijevod'),button=document.getElementById('findAudio');
const counts=[7, 286, 200, 176, 120, 165, 206, 75, 129, 109, 123, 111, 43, 52, 99, 128, 111, 110, 98, 135, 112, 78, 118, 64, 77, 227, 93, 88, 69, 60, 34, 30, 73, 54, 45, 83, 182, 88, 75, 85, 54, 53, 89, 59, 37, 35, 38, 29, 18, 45, 60, 49, 62, 55, 78, 96, 29, 22, 24, 13, 14, 11, 11, 18, 12, 12, 30, 52, 52, 44, 28, 28, 20, 56, 40, 31, 50, 40, 46, 42, 29, 19, 36, 25, 22, 17, 19, 26, 30, 20, 15, 21, 11, 8, 8, 19, 5, 8, 8, 11, 11, 8, 3, 9, 5, 4, 7, 3, 6, 3, 5, 4, 5, 6];
const translations={"1:1": "U ime Allaha, Svemilosnog, Milostivog.", "1:2": "Sva hvala pripada Allahu, Gospodaru svjetova.", "1:3": "Svemilosnom, Milostivom.", "1:4": "Vladaru Dana obračuna.", "1:5": "Samo Tebi robujemo i samo od Tebe pomoć tražimo.", "1:6": "Uputi nas na pravi put.", "1:7": "Put onih kojima si darovao blagodati, a ne onih na koje je pala srdžba, niti onih koji su zalutali.", "2:1": "Elif, Lâm, Mîm (O Muhammede)", "2:2": "To je knjiga o kojoj nikakve sumnje nema. Ona je putokaz bogobojaznima,", "2:3": "koji vjeruju u neviđeno, klanjaju namaz, dijele i pomažu druge sa onim što smo im darovali.", "2:4": "I onima koji vjeruju u ono što je objavljeno Tebi i u ono što je objavljeno prije Tebe, i koji su od svog Gospodara upućeni na pravi put.", "2:5": "To su oni, koji su spašeni i koji su do svog cilja došli.", "2:6": "Zaista onima, koji ne vjeruju, svejedno je da li si ti njih opomenuo ili ih nijesi opomenuo (od posljedica puta kojim oni idu). Oni neće vjerovati.", "2:7": "Srca i uši ovih Bog je zapečatio, a pred očima zastor stavio. Njih čeka teška kazna!", "2:8": "Neki ljudi govore i ako nijesu vjernici: »Mi vjerujemo Allaha i Sudnji dan.«", "2:9": "Oni žele da prevare Boga i one koji vjeruju. Oni varaju samo sebe, a to ne znaju.", "2:10": "Srca su ovih bolesna. I Bog im je bolest povećao. Zato, što su lagali, čeka ih teška kazna.", "2:11": "Kada im se rekne: »Ne pravite smutnje po zemlji«, oni tada odgovaraju: »Mi smo ljudi, koji samo na zemlji žele red i mir«.", "2:12": "Dobro znaj i oči otvori, oni su pravi smutljivci, ali to ne mogu da shvate.", "2:13": "Kada im se rekne: »Vjerujte kao što i drugi ljudi vjeruju!« onda oni odgovaraju: »Zar ćemo mi vjerovati, kao što lude vjeruju?« Zapravo su oni lude, ali oni to ne znaju.", "2:14": "A kada se sretnu sa onima koji vjeruju, govore im: »I mi vjerujemo«, ali kad se sa svojim zavodnicima nađu na samu, onda im kažu: »Mi smo s vama, samo se njima izrugivamo«.", "2:15": "Allah će njih ruglu izvrgnuti i pustit će ih, da u zabludi svojoj bez cilja tumaraju i lutaju.", "2:16": "To su ljudi, koji su izabrali zabludu mjesto pravog puta. Njihova glavnica im neće donijeti koristi, niti će biti upućeni na pravi put.", "2:17": "Stanje ovih ljudi je slično čovjeku, koji je naložio vatru da mu osvijetli, pa kad se oko njega rasvijetlilo, Allah je to svjetlo (nekim uzrokom) odstranio i ostavio ih u tmini, da više ništa ne mogu vidjeti.", "2:18": "Oni su gluhi, slijepi i nijemi i nemaju mogućnosti da se sa te staze povrate.", "2:19": "Ili oni sliče ljudima, koje je uhvatio tmasti oblak iz koga pljušti, sijeva i grmi, i oni u smrtnom strahu začepljaju pred tom grmljavinom uši. Ali nevjernike će snaći kazna Božja.", "2:20": "Sijevanje kao da zasljepljuje poglede njihove, svaki put kad oko njih osvijetli, oni naprijed pođu, ali kad tama zavlada, onda zastanu. A kad bi Bog htio, uništio bi im i sluh i vid njihov. Samo Bog sve može učiniti.", "2:21": "O ljudi, obožavajte Boga, koji je vas stvorio i one prije vas, da bi tako došli u red sačuvanih i bogobojaznih.", "2:22": "Koji vam zemlju (da bi na njoj mirno i spokojno obitavali) prostrije kao postelju, a nebo podiže kao svod. Spusti vam s neba kišu, da bi tako kao hrana vaša nicali i rasli plodovi zemaljski. Pa onda nemojte Allahu zamišljati pomagača, a vi znate (da On toga nema).", "2:23": "Ako vi sumnjate u Kur’an što smo ga objavili Našem robu (Muhammedu), onda vi načinite jedno poglavlje slično njegovim i pozovite one bogove, koje mjesto Boga obožavate da vam pomognu, pa ako su vaše tvrdnje istinite, onda ih utvrdite (da je Kur’an Muhammedovo djelo).", "2:24": "Ali ako ovo ne učinite, a sigurno učiniti nećete, onda se čuvajte vatre koja je za nevjernike priređena, a čije je gorivo ljudi i kamenje.", "2:25": "(Muhammede!) Objavi radosnu vijest onima, koji vjeruju i dobra djela čine: za njih imaju vrtovi ispod kojih rijeke teku. I kad plodove tih vrtova budu jeli i uživali, reći će: »ovo su stvari koje smo i prije uživali«. Plodovi će jedni drugima sličiti, a oni će imati čiste (i nježne) družice i tamo će vječno boraviti.", "2:26": "Zaista se Bog ne susteže od toga da vam kao primjer pruži komaricu i stvari koje su od nje veće. Oni, koji vjeruju, znaju dobro da je ovo prava istina od Gospodara njihova, a nevjernici govore, šta je Bog htio sa iznošenjem ovakih primjera? Iznoseći ove primjere Allah mnoge ostavlja u zabludi, a mnoge upućuje na pravi put. Samo će hrđave i nevaljalce ostaviti u zabludi.", "2:27": "Ovi nevaljalci krše Bogu danu obavezu i kidaju ono, što je Bog naredio da se veže, a po zemlji siju razdor i smutnju. To su oni, koji sami sebi štetu čine.", "2:28": "Kako ćete vi Allaha zaboraviti i zanijekati, kada ste mrtvi bili, a on vam je život dao, a kasnije će vas usmrtiti pa onda opet oživiti i napokon ćete se svi Njemu morati povratiti.", "2:29": "Sve što se na zemlji nalazi stvorio je za vas (vašu korist), a stvarajući nebesa u najsavršenijem redu stvorio je sedmerokatna nebesa. On svaku stvar najbolje zna.", "2:30": "Kada je tvoj Gospodar anđelima (melekima) rekao: »Ja ću na zemlji stvoriti onog, koji će njom vladati i gospodariti«, oni mu na to odgovore: »Hoćeš li stvoriti na zemlji čovjeka, koji će po njoj smutnju sijati i krv prolijevati?«, a mi Te slavimo, hvalimo Te i obožavamo Te. Bog je rekao: »Ja znam što vi ne znate«.", "2:31": "Allah je Adema naučio imena svih stvari. Zatim ih je predočio anđelima i rekao im: »Ako je vaša tvrdnja ispravna, kažite mi imena ovih stvari«.", "2:32": "Anđeli rekoše: »Velik si, slavljen si i moćan si Bože! Mi znamo samo ono, što si nas Ti naučio. Ti si onaj, što svaku stvar u suštini njenoj znaš, što sve sa mudrošću radiš.«", "2:33": "Allah reče: »Ademe! pouči ih imena ovih stvari«. Adem ih pouči, a Allah reče: »Zar vam nijesam rekao da Ja samo znam sve tajne na nebu i na zemlji i ono što vi otvoreno činite i što sakrivate?«", "2:34": "Kad smo rekli melekima: učinite sedždu Ademu! (poklonite se Ademu). svi su se poklonili osim Iblisa. On se ustegao i oholo se ponio, jer je spadao među nezahvalne i nevjernike.", "2:35": "I mi smo rekli: »O Ademe: »Nastani se sa svojom družicom u džennetu (raju) i u obilju jedite sve što zaželite, ali se ne priključujte ovom stablu, jer ćete biti neposlušni i silnici«.", "2:36": "Satana ih je naveo pa su posrnuli i skrenuo ih je sa puta poslušnosti. I izvadio ih je iz blagodati u kojoj su bili. A mi smo rekli: Idite i silazite odavle, jer među sobom neprijateljstvo gajite, a vaš boravak će biti i život vaš do određenog roka na zemlji.", "2:37": "Adem je uzeo i zapamtio neke riječi od svoga Gospodara i pokajao se. Bog je primio njegovo pokajanje. Bog prima pokajanje svojih robova koje iz milosti i ljubavi stvara.", "2:38": "Da, mi smo rekli: silazite svi iz njega, pa kad vam dođe od mene vodič, ko ga bude slijedio, neće poznavati ni straha ni tuge.", "2:39": "Koji zaniječu naše znakove i dokaze i budu ih smatrali lažnim, biće drugovi u paklu i vječno će trpiti muke paklene.", "2:40": "O sinovi Israilovi! Sjetite se Mojih blagodati, koje sam vam podario! Izvršite obavezu Moju prema Meni, pa ću i Ja ispuniti obećanje koje sam vam dao. Bojite se Mene, jer ćete svi preda Me doći.", "2:41": "Vjerujte ovu knjigu koju sam objavio, a koja potvrđuje istinitost Tevrata, koji je kod vas, i ne budite prvi koji će je zanijekati, i ne žrtvujte ove moje dokaze (ajete) za neku neznatnu korist. Čuvajte se, jer vam valja preda Me doći.", "2:42": "I ne zastrite Istine sa neistinom (miješajući jedno s drugim) i ne sakrivajte Istine, a vi znate (da to činite).", "2:43": "Klanjajte namaz, dijelite zekat i činite ruku’ — saginjite se — zajedno sa onima koji ruku’ čine.", "2:44": "Zar vi naređujete svijetu da čini dobro, a sebe zaboravljate? A vi ste koji učite knjigu. Kako vi mislite i odakle to razumijete? Da li imate pameti u glavi?", "2:45": "U strpljenju i molitvi (namazu) tražite pomoći od Boga! Molitva i strpljenje su teške (slabićima) ali bogobojazni,", "2:46": "koji su uvjereni da će jednog dana doći pred svoga Gospodara i da će se Njemu vratiti, ne osjećaju te težine.", "2:47": "O sinovi Israilovi! Sjetite se Mojih blagodati, koje sam vam podario, sjetite se, da sam vas odlikovao i uzdigao nad druge narode!", "2:48": "Čuvajte se onoga dana, kad više niko neće moći tuđeg prava ispuniti, kad se više ničiji zagovor neće primiti, kad se od nevjernih neće moći uzeti ošteta za učinjena nasilja i nepravde i kad se više nevjernicima neće moći pomoći.", "2:49": "Sjetite se kad smo vas spasili od groznih muka, na koje su vas bili Fir’avni stavili. Klali su vaše sinove, a na životu su ostavljali vaše kćeri. Ovo je bilo za vas veliko iskušenje od vašeg Gospodara.", "2:50": "Mi smo vam more rastupili i vas spasili, a na vaše oči Fir’avne potopili."};
let verse=1;
function key(){return Number(sura.value)+':'+verse}
function refresh(){current.textContent='Ajet '+verse+' od '+counts[Number(sura.value)-1];bos.textContent=translations[key()]||'Bosanski prijevod ovog ajeta još nije unesen.'}
// Jedan neprekinuti snimak za cijelu suru. Izvor nije lokalno hostovan.

